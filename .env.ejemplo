# Copie este archivo como .env en el servidor y complete los valores.
# El archivo .env NO se sube a GitHub.

# Clave secreta larga y aleatoria (la guía explica cómo generarla).
DJANGO_SECRET_KEY=

# En el servidor siempre False.
DJANGO_DEBUG=False

# Dirección del sitio, por ejemplo: edwcaso77.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=
